<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">#070913</item>
        <item name="colorPrimaryDark">#070913</item>
        <item name="colorAccent">#3B82F6</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">#F8FAFC</item>
    </style>

    <!-- 🎨 CRISP SPLASH WITH LOGO + TEXT -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <!-- Main window background using our layered drawable -->
        <item name="windowSplashScreenBackground">#F8FAFC</item>
        <item name="android:windowSplashScreenBackground">#F8FAFC</item>

        <!-- Center Icon pointing to full splash image -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_background</item>

        <!-- Status Bar -->
        <item name="android:statusBarColor">#F8FAFC</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

</resources>
